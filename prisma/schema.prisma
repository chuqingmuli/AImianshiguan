// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  isTemporary   Boolean     @default(false) // 快速体验模式：临时用户标识
  createdAt     DateTime    @default(now())
  
  // 关系
  interviews Interview[]
  resumes    Resume[]
  accounts   Account[]
  sessions   Session[]
  
  @@map("users")
}

model Interview {
  id          String          @id @default(cuid())
  userId      String
  type        String          // 'java' | 'web' - 面试类型
  status      String          // preparing → active → completed → cancelled - 状态流转
  title       String
  description String?
  createdAt   DateTime        @default(now())
  startedAt   DateTime?       // 面试开始时间
  completedAt DateTime?       // 面试结束时间
  duration    Int?            // 面试时长（单位：秒）
  sessionId   String?         // 会话标识，用于AI服务
  
  // 关系
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]
  evaluations   EvaluationReport[]
  
  // 索引
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  
  @@map("interviews")
}

model Message {
  id          String    @id @default(cuid())
  interviewId String
  role        String    // 'user' | 'assistant' - 消息角色
  content     String    // 消息内容（文本）
  timestamp   DateTime  @default(now()) // 消息时间戳
  audioUrl    String?   // 语音消息URL（扩展字段）
  messageType String    @default("text") // 消息类型：text | audio
  
  // 关系
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  
  // 索引
  @@index([interviewId])
  @@index([role])
  @@index([timestamp])
  
  @@map("messages")
}

model EvaluationReport {
  id          String    @id @default(cuid())
  interviewId String
  scores      String    // 多维度评分（JSON字符串）：{technical, communication, problemSolving, knowledgeDepth, overall}
  feedback    String?   // 总体评价和建议
  strengths   String?   // 优势总结（逗号分隔）
  improvements String?  // 改进建议（逗号分隔）
  createdAt   DateTime  @default(now())
  
  // 关系
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  
  // 索引
  @@index([interviewId])
  
  @@map("evaluation_reports")
}

model Resume {
  id          String    @id @default(cuid())
  userId      String
  fileName    String?   // 简历文件名
  content     String?   // 简历文本内容
  fileUrl     String?   // 简历文件URL
  fileType    String?   // 文件类型：pdf | docx | txt
  parsedData  String?   // 解析后的结构化数据（JSON字符串）
  isParsed    Boolean   @default(false) // 是否已解析
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  
  // 关系
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 索引
  @@index([userId])
  
  @@map("resumes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}